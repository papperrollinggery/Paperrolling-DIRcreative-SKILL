      ],
      "expected_error": "binding_local_order_outside_unit_scope"
    },
    {
      "case_id": "asset_id_bound_twice",
      "mutations": [
        {"op": "replace", "path": "/bindings/1/asset_id", "value": "VE-RING-ID-v01"}
      ],
      "expected_error": "binding_asset_id_duplicate"
