      "case_id": "asset_stress_report_hash_mismatch",
      "mutations": [
        {"op": "replace", "path": "/asset_foundation_gate/stress_report_sha256", "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}
      ],
      "expected_error": "asset_stress_file_hash_mismatch"
    },
    {
      "case_id": "asset_stress_unverified_compiles",
      "mutations": [
        {"op": "replace", "path": "/asset_foundation_gate/stress_verdict", "value": "unverified"}
      ],
      "expected_error": "asset_stress_verdict_not_compilable"
