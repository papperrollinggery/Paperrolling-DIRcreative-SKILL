    {
      "case_id": "asset_gate_cross_project_reuse",
      "mutations": [
        {"op": "replace", "path": "/project_id", "value": "PROJECT-OTHER"}
      ],
      "expected_error": "asset_project_binding_mismatch"
    },
    {
      "case_id": "asset_gate_coverage_mismatch",
      "mutations": [
        {"op": "replace", "path": "/asset_foundation_gate/covered_asset_ids", "value": ["CHAR-OTHER"]}
      ],
      "expected_error": "asset_foundation_binding_mismatch"
    },
    {
      "case_id": "attached_asset_missing_stress_coverage",
      "mutations": [
        {"op": "replace", "path": "/asset_foundation_gate/covered_asset_ids", "value": ["VE-RING-ID-v01", "CF-GU01-END-v01"]}
      ],
      "expected_error": "asset_binding_stress_coverage_missing"
    },
    {
      "case_id": "attached_asset_bytes_swapped_after_stress",
      "mutations": [
        {"op": "replace", "path": "/bindings/0/sha256", "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}
      ],
      "expected_error": "binding_asset_hash_mismatch"
    },
    {
      "case_id": "attached_asset_binding_missing_version",
      "mutations": [
        {"op": "remove", "path": "/bindings/0/asset_version"}
