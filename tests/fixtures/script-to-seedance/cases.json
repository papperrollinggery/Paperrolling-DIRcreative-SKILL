      "expected_error": "schema_error"
    },
    {
      "case_id": "prompt_payload_hash_mismatch",
      "mutations": [
        {"op": "replace", "path": "/prompt_units/0/prompt_sha256", "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}
      ],
      "expected_error": "prompt_payload_hash_mismatch"
    },
    {
      "case_id": "prompt_status_mismatch",
      "mutations": [
        {"op": "replace", "path": "/prompt_units/0/status", "value": "instructions_only"}
      ],
      "expected_error": "prompt_status_mismatch"
    },
    {
      "case_id": "prompt_reference_slot_missing",
      "mutations": [
        {"op": "replace", "path": "/prompt_units/0/prompt_text", "value": "@Image 1 locks ring identity.\n\n\nShow the enemy entering and the ring receiving one fixed strike."}
      ],
      "expected_error": "prompt_reference_slot_scope_mismatch"
    },
    {
      "case_id": "authoritative_dialogue_missing_from_prompt",
      "mutations": [
        {"op": "replace", "path": "/prompt_units/1/prompt_text", "value": "@Image 1 locks ring identity. @Image 2 locks route layout only.\n\n\nThe fighter completes the counteraction without dialogue."}
      ],
      "expected_error": "prompt_dialogue_missing"
    },
    {
      "case_id": "prompt_artifact_id_duplicated",
      "mutations": [
        {"op": "replace", "path": "/prompt_units/1/artifact_id", "value": "SEEDANCE-GU01-PROMPT-v1"}
      ],
      "expected_error": "prompt_artifact_id_duplicate"
    },
    {
      "case_id": "duplicate_text_dialogue_requires_two_occurrences",
      "mutations": [
        {
          "op": "add",
          "path": "/authoritative_script/dialogue_lines/-",
          "value": {
            "dialogue_line_id": "DLG-002",
            "speaker_entity_id": "pilot",
            "text": "执行反击。",
            "shot_ids": ["SH04"]
          }
        }
      ],
      "expected_error": "prompt_dialogue_count_mismatch"
    },
    {
      "case_id": "dialogue_line_id_duplicated",
      "mutations": [
        {
          "op": "add",
          "path": "/authoritative_script/dialogue_lines/-",
          "value": {
            "dialogue_line_id": "DLG-001",
            "speaker_entity_id": "pilot",
            "text": "再次确认。",
            "shot_ids": ["SH04"]
          }
        }
      ],
      "expected_error": "dialogue_line_id_duplicate"
    },
    {
      "case_id": "asset_foundation_gate_missing",
      "mutations": [
        {"op": "remove", "path": "/asset_foundation_gate"}
      ],
      "expected_error": "schema_error"
