    {
      "case_id": "asset_scope_blocked",
      "mutations": [
        {"op": "replace", "path": "/asset_foundation_gate/requested_shot_ids", "value": ["SH02"]},
        {"op": "replace", "path": "/asset_foundation_gate/allowed_shot_ids", "value": ["SH01"]},
        {"op": "replace", "path": "/asset_foundation_gate/blocked_shot_ids", "value": ["SH02"]}
      ],
      "expected_error": "asset_scope_not_allowed"
    },
    {
      "case_id": "asset_stress_matrix_incomplete",
      "mutations": [],
      "dependency_mutations": {
        "stress": [
          {"op": "replace", "path": "/test_cases/0/status", "value": "not_run"},
          {"op": "replace", "path": "/test_cases/0/evidence", "value": []}
        ]
      },
      "expected_error": "asset_stress_report_invalid"
    },
    {
      "case_id": "asset_foundation_stage_failed",
      "mutations": [],
      "dependency_mutations": {
        "foundation": [
          {"op": "replace", "path": "/stages/2/status", "value": "failed"}
        ]
      },
      "expected_error": "asset_foundation_pass_invalid"
