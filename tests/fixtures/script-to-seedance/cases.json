      "mutations": [
        {"op": "replace", "path": "/bindings/1/media_type", "value": "audio"},
        {"op": "replace", "path": "/bindings/1/converter_slot", "value": "【音频2】"},
        {"op": "replace", "path": "/bindings/1/platform_slot", "value": "@Audio 2"}
