{
  "schema_version": "1.0",
  "cases": [
    {
      "case_id": "planned_audio_attached",
      "mutations": [
        {"op": "replace", "path": "/bindings/5/attached_to_run", "value": true}
      ],
      "expected_error": "binding_nonavailable_attached"
    },
    {
      "case_id": "narrative_frame_promoted_to_literal",
      "mutations": [
        {"op": "replace", "path": "/bindings/4/literal_frame_boolean", "value": true}
      ],
      "expected_error": "planning_source_promoted"
    },
    {
      "case_id": "reference_budget_exceeded",
      "mutations": [
        {"op": "replace", "path": "/provider_limits/max_references_per_unit", "value": 1}
      ],
      "expected_error": "provider_reference_budget_exceeded"
    },
    {
      "case_id": "platform_slot_number_mismatch",
      "mutations": [
        {"op": "replace", "path": "/bindings/0/platform_slot", "value": "@Image 9"}
      ],
      "expected_error": "binding_slot_number_mismatch"
    },
    {
      "case_id": "illegal_state_jump",
      "mutations": [
        {"op": "replace", "path": "/generation_units/0/continuity_out/ring", "value": "RING-D2"},
        {"op": "replace", "path": "/generation_units/1/continuity_in/ring", "value": "RING-D2"}
      ],
      "expected_error": "continuity_transition_invalid"
    },
    {
      "case_id": "local_order_missing",
