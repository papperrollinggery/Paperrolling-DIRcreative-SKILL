{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dircreative.visual-asset-plan/2.3",
  "title": "DIRcreative Visual Asset Plan",
  "description": "Exact, inventory-bound visual-preproduction coverage for a whole film, one sequence, or an explicitly bounded sample. This contract may prove visual assets complete; it cannot accept a finished TVC master.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "truth_revision",
    "truth_locked_at",
    "inventory_file",
    "inventory_sha256",
    "creative_source_file",
    "creative_source_sha256",
    "shot_cards_file",
    "shot_cards_sha256",
    "shot_truth_sha256",
    "scope",
    "duration_seconds",
    "delivery_profile",
    "scene_ids",
    "character_ids",
    "appearance_state_ids",
    "product_ids",
    "prop_ids",
    "shot_ids",
    "shot_truth",
    "rhythm_point_ids",
    "rhythm_points",
    "style_reference_required",
    "generation_units",
    "assets",
    "completion_claim"
  ],
  "properties": {
    "schema_version": {"const": "2.3"},
    "project_id": {"$ref": "#/$defs/id"},
    "truth_revision": {"$ref": "#/$defs/id"},
    "truth_locked_at": {"$ref": "#/$defs/utcTimestamp"},
    "inventory_file": {"type": "string", "minLength": 1},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "creative_source_file": {"type": "string", "minLength": 1},
    "creative_source_sha256": {"$ref": "#/$defs/sha256"},
    "shot_cards_file": {"type": "string", "minLength": 1},
    "shot_cards_sha256": {"$ref": "#/$defs/sha256"},
    "shot_truth_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {"enum": ["whole_film", "sequence", "representative_sample", "asset_only"]},
    "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "delivery_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medium",
        "aspect_ratio",
        "raster_width",
        "raster_height",
        "frame_rate_fps",
        "audio_sample_rate_hz",
        "action_safe_percent",
        "title_safe_percent",
        "brand_endframe_min_seconds",
        "target_master_spec_status"
      ],
      "properties": {
        "medium": {"enum": ["broadcast_tvc", "cinema", "web", "social", "other", "still"]},
        "aspect_ratio": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?:[0-9]+(?:\\.[0-9]+)?$"},
        "raster_width": {"type": "integer", "minimum": 1},
        "raster_height": {"type": "integer", "minimum": 1},
        "frame_rate_fps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "audio_sample_rate_hz": {"type": ["integer", "null"], "minimum": 1},
        "action_safe_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "title_safe_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "brand_endframe_min_seconds": {"type": "number", "minimum": 0},
        "target_master_spec_status": {"enum": ["fixture_baseline", "requires_target_spec", "locked_target"]}
      }
    },
    "scene_ids": {"$ref": "#/$defs/idList"},
    "character_ids": {"$ref": "#/$defs/idList"},
    "appearance_state_ids": {"$ref": "#/$defs/idList"},
    "product_ids": {"$ref": "#/$defs/idList"},
    "prop_ids": {"$ref": "#/$defs/idList"},
    "shot_ids": {"$ref": "#/$defs/idList"},
    "shot_truth": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "scene_id", "character_ids", "appearance_state_ids", "product_ids", "prop_ids", "story_beat_ids", "script_line_ids", "generation_unit_id", "narrative_purpose", "timecode", "duration_seconds", "shot_design", "action", "sound_edit", "continuity_model"],
        "properties": {
          "shot_id": {"$ref": "#/$defs/id"},
          "scene_id": {"$ref": "#/$defs/id"},
          "character_ids": {"$ref": "#/$defs/idList"},
          "appearance_state_ids": {"$ref": "#/$defs/idList"},
          "product_ids": {"$ref": "#/$defs/idList"},
          "prop_ids": {"$ref": "#/$defs/idList"},
          "story_beat_ids": {"$ref": "#/$defs/nonEmptyIdList"},
          "script_line_ids": {"$ref": "#/$defs/idList"},
          "generation_unit_id": {"$ref": "#/$defs/id"},
          "narrative_purpose": {"type": "string", "minLength": 12},
          "timecode": {"type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9](?:\\.[0-9]+)?-[0-9]{2,}:[0-5][0-9](?:\\.[0-9]+)?$"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "shot_design": {"type": "string", "minLength": 12},
          "action": {"type": "string", "minLength": 12},
          "sound_edit": {"type": "string", "minLength": 12},
          "continuity_model": {"type": "string", "minLength": 12},
          "scene_state_source": {
            "type": "object", "additionalProperties": false,
            "required": ["relative_path", "sha256"],
            "properties": {
              "relative_path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "rhythm_point_ids": {"$ref": "#/$defs/idList"},
    "rhythm_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "timecode", "shot_ids", "action", "sound_transition"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "timecode": {"type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9](?:\\.[0-9]+)?$"},
          "shot_ids": {"$ref": "#/$defs/nonEmptyIdList"},
          "action": {"type": "string", "minLength": 12},
          "sound_transition": {"type": "string", "minLength": 12}
        }
      }
    },
    "style_reference_required": {"type": "boolean"},
    "generation_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "shot_ids", "direct_input_min", "direct_input_max", "direct_input_roles", "direct_input_not_required_reason"],
        "properties": {
          "unit_id": {"$ref": "#/$defs/id"},
          "shot_ids": {"$ref": "#/$defs/nonEmptyIdList"},
          "direct_input_min": {"type": "integer", "minimum": 0},
          "direct_input_max": {"type": "integer", "minimum": 0},
          "direct_input_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["clean_first_frame", "clean_key_frame", "clean_end_frame"]}
          },
          "direct_input_not_required_reason": {"type": "string"},
          "storyboard_strategy": {"enum": ["individual_frames", "annotated_reference"]},
          "storyboard_acquisition": {"enum": ["native_generate", "assembled_model_panels"]}
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "role",
          "required",
          "action",
          "purpose",
          "coverage",
          "inherits_from",
          "planning_only",
          "direct_video_input",
          "status",
          "generated_file",
          "generated_sha256",
          "generated_pixel_sha256",
          "generated_perceptual_hash",
          "truth_sha256",
          "technical_receipt",
          "visual_qa_receipt",
          "compile_route"
        ],
        "properties": {
          "asset_id": {"$ref": "#/$defs/id"},
          "role": {
            "enum": [
              "character_identity_reference",
              "product_identity_board",
              "prop_continuity_board",
              "scene_geography_camera_fov_reference",
              "lighting_material_style_board",
              "storyboard_frame",
              "professional_storyboard_motion_map",
              "clean_first_frame",
              "clean_key_frame",
              "clean_end_frame"
            ]
          },
          "required": {"type": "boolean"},
          "action": {"enum": ["reuse", "derive", "generate", "assemble"]},
          "purpose": {"type": "string", "minLength": 1},
          "compile_route": {"enum": ["direct_concise", "selected_skill_handoff", "deterministic_assembly"]},
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scene_ids", "character_ids", "appearance_state_ids", "product_ids", "prop_ids", "shot_ids", "generation_unit_ids"],
            "properties": {
              "scene_ids": {"$ref": "#/$defs/idList"},
              "character_ids": {"$ref": "#/$defs/idList"},
              "appearance_state_ids": {"$ref": "#/$defs/idList"},
              "product_ids": {"$ref": "#/$defs/idList"},
              "prop_ids": {"$ref": "#/$defs/idList"},
              "shot_ids": {"$ref": "#/$defs/idList"},
              "generation_unit_ids": {"$ref": "#/$defs/idList"}
            }
          },
          "inherits_from": {"$ref": "#/$defs/idList"},
          "planning_only": {"type": "boolean"},
          "direct_video_input": {"type": "boolean"},
          "status": {"enum": ["planned", "prompt_ready", "generated_candidate", "user_locked", "reused_locked", "rejected"]},
          "generated_file": {"type": "string"},
          "generated_sha256": {"type": "string", "pattern": "^(?:|[a-f0-9]{64})$"},
          "generated_pixel_sha256": {"type": "string", "pattern": "^(?:|[a-f0-9]{64})$"},
          "generated_perceptual_hash": {"type": "string", "pattern": "^(?:|[a-f0-9]{64})$"},
          "truth_sha256": {"$ref": "#/$defs/sha256"},
          "technical_receipt": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/technicalReceipt"}
            ]
          },
          "visual_qa_receipt": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/visualQaReceipt"}
            ]
          },
          "character_mode": {"type": ["string", "null"], "enum": ["headed_master", "headed_state", "headless_safe", null]},
          "derived_from_asset_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "approved_source_master_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "character_contract_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "candidate_repair_source": {"type":"object","additionalProperties":false,"required":["contract_id","project_id","asset_id","truth_sha256","source_plan","source_image","self_check","changes"],"properties":{"contract_id":{"const":"candidate_repair_source_v1"},"project_id":{"type":"string","minLength":1},"asset_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},"truth_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"source_plan":{"type":"object","additionalProperties":false,"required":["relative_path","sha256"],"properties":{"relative_path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"source_image":{"type":"object","additionalProperties":false,"required":["relative_path","sha256","pixel_sha256"],"properties":{"relative_path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"pixel_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"self_check":{"type":"object","additionalProperties":false,"required":["relative_path","sha256"],"properties":{"relative_path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"changes":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["check_id","instruction"],"properties":{"check_id":{"type":"string","minLength":1},"instruction":{"type":"string","minLength":12,"maxLength":4096}}}}}},
          "execution_task_id": {"$ref": "#/$defs/id"},
          "candidate_self_check": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false,
               "required": ["relative_path", "sha256"],
               "properties": {"relative_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
            ]
          }
        }
      }
    },
    "completion_claim": {"enum": ["none", "plan_complete", "sample_plan_complete", "asset_only_plan_complete", "sample_visual_assets_complete", "visual_assets_complete"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "idList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonEmptyIdList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "technicalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_version", "asset_id", "file_sha256", "pixel_sha256", "perceptual_hash", "ruleset", "checked_at", "decoder", "normalization_profile", "format", "width", "height", "status", "receipt_sha256"],
      "properties": {
        "receipt_version": {"const": "2.0"},
        "asset_id": {"$ref": "#/$defs/id"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "pixel_sha256": {"$ref": "#/$defs/sha256"},
        "perceptual_hash": {"$ref": "#/$defs/sha256"},
        "ruleset": {"const": "dircreative-raster-evidence-v4"},
        "checked_at": {"$ref": "#/$defs/utcTimestamp"},
        "decoder": {"enum": ["pillow-full-decode", "stdlib-png-full-decode"]},
        "normalization_profile": {"const": "rgba8-oriented-v1"},
        "format": {"const": "PNG"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "status": {"const": "technical_evidence_pass"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "visualQaReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_version", "asset_id", "file_sha256", "pixel_sha256", "truth_sha256", "ruleset", "reviewed_at", "reviewer_type", "reviewer_id", "review_task_id", "review_manifest_file", "review_manifest_sha256", "review_subject_sha256", "status", "receipt_sha256"],
      "properties": {
        "receipt_version": {"const": "2.0"},
        "asset_id": {"$ref": "#/$defs/id"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "pixel_sha256": {"$ref": "#/$defs/sha256"},
        "truth_sha256": {"$ref": "#/$defs/sha256"},
        "ruleset": {"const": "dircreative-role-truth-review-v2"},
        "reviewed_at": {"$ref": "#/$defs/utcTimestamp"},
        "reviewer_type": {"enum": ["human", "independent_ai", "authorized_reviewer"]},
        "reviewer_id": {"$ref": "#/$defs/id"},
        "review_task_id": {"$ref": "#/$defs/id"},
        "review_manifest_file": {"type": "string", "minLength": 1},
        "review_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "review_subject_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "visual_qa_pass"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
