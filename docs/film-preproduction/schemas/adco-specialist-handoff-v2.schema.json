{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adco.specialist-exchange/handoff/2.0",
  "title": "ADCO specialist handoff v2",
  "type": "object",
  "required": [
    "protocol_id",
    "contract_version",
    "task",
    "brief_snapshot",
    "locked_decisions",
    "requested_outputs",
    "quality_targets",
    "execution_mode"
  ],
  "properties": {
    "protocol_id": {"const": "adco.specialist-exchange"},
    "contract_version": {"const": "2.0"},
    "task": {"type": "string", "minLength": 1},
    "brief_snapshot": {"$ref": "#/$defs/relativePath"},
    "locked_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lockedDecision"}
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requestedOutput"}
    },
    "quality_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "execution_mode": {"const": "inline"}
  },
  "$defs": {
    "safeToken": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "lockedDecision": {
      "type": "object",
      "required": ["artifact_id", "type", "path", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/safeToken"},
        "type": {"$ref": "#/$defs/safeToken"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "requestedOutput": {
      "type": "object",
      "required": ["output_id", "type", "path_root"],
      "properties": {
        "output_id": {"$ref": "#/$defs/safeToken"},
        "type": {"$ref": "#/$defs/safeToken"},
        "path_root": {"$ref": "#/$defs/relativePath"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
