{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adco-specialist-handoff-v2.schema.json",
  "title": "ADCO Specialist Exchange v2 Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "contract_version",
    "task",
    "brief_snapshot",
    "locked_decisions",
    "requested_outputs",
    "quality_targets",
    "execution_mode"
  ],
  "properties": {
    "protocol_id": {
      "const": "adco.specialist-exchange"
    },
    "contract_version": {
      "const": "2.0"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "brief_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "locked_decisions": {
      "$ref": "#/$defs/stringList"
    },
    "requested_outputs": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "quality_targets": {
      "$ref": "#/$defs/stringList"
    },
    "execution_mode": {
      "const": "inline"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
