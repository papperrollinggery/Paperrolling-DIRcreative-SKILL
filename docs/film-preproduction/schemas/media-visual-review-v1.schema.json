{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperrolling.local/dircreative/media-visual-review-v1.schema.json",
  "title": "DIRcreative Independent Media Visual Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "candidate_commit",
    "execution_receipt_sha256",
    "host_trace",
    "reviewer",
    "rubric",
    "rubric_sha256",
    "artifact_reviews",
    "continuity_review",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product": {"const": "DIRcreative"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "host_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_id",
        "prefix_bytes",
        "prefix_sha256",
        "review_request_event_id",
        "view_event_ids",
        "review_claim_sha256",
        "evidence_level",
        "cryptographically_signed"
      ],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "prefix_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "prefix_sha256": {"$ref": "#/$defs/sha256"},
        "review_request_event_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "view_event_ids": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "review_claim_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_level": {"const": "unsigned_host_trace"},
        "cryptographically_signed": {"const": false}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "task_id", "review_method", "input_scope", "started_at", "completed_at"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "review_method": {"const": "independent_visual_review"},
        "input_scope": {"const": "raw_references_outputs_and_rubric_only"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "rubric": {"type": "string", "minLength": 20},
    "rubric_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_reviews": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "artifact_sha256", "decision", "observations"],
        "properties": {
          "subject_id": {"$ref": "#/$defs/snakeId"},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "decision": {"enum": ["reject", "accept", "pass"]},
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 12}
          }
        }
      }
    },
    "continuity_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_ids", "decision", "continuity_lock_sha256", "observations"],
      "properties": {
        "shot_ids": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/snakeId"}
        },
        "decision": {"const": "pass"},
        "continuity_lock_sha256": {"$ref": "#/$defs/sha256"},
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 12}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snakeId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
  }
}
