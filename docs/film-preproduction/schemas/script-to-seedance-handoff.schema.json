{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dircreative.local/schemas/script-to-seedance-handoff.schema.json",
  "title": "DIRcreative to convert-script-to-seedance handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "authority",
    "source_owner",
    "target_owner",
    "output_owner",
    "project_id",
    "status",
    "timeline_policy",
    "provider_limits",
    "asset_foundation_gate",
    "authoritative_script",
    "entity_ownership",
    "model_surface",
    "narrative_nodes",
    "shots",
    "generation_units",
    "continuity_states",
    "bindings",
    "prompt_units"
  ],
  "properties": {
    "contract_id": {"const": "script_to_seedance_v1"},
    "authority": {"const": "compile_only"},
    "source_owner": {"const": "dircreative"},
    "target_owner": {"const": "convert-script-to-seedance"},
    "output_owner": {"const": "dircreative"},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["prompt_only", "instructions_only"]},
    "timeline_policy": {
      "enum": ["external_timeline_only", "prompt_macro_ranges", "prompt_shot_ranges"]
    },
    "provider_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_references_per_unit", "max_image_references_per_unit", "max_video_references_per_unit", "max_audio_references_per_unit", "source_type", "verification_status", "source"],
      "properties": {
        "max_references_per_unit": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_image_references_per_unit": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_video_references_per_unit": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_audio_references_per_unit": {"type": "integer", "minimum": 0, "maximum": 64},
        "source_type": {"type": "string", "minLength": 1},
        "verification_status": {"const": "verified"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "method_application": {"$ref": "#/$defs/method_application"},
    "asset_foundation_gate": {"$ref": "#/$defs/asset_foundation_gate"},
    "authoritative_script": {"$ref": "#/$defs/authoritative_script"},
    "entity_ownership": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity_ownership"}
    },
    "model_surface": {"$ref": "#/$defs/model_surface"},
    "narrative_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/narrative_node"}
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot"}
    },
    "generation_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/generation_unit"}
    },
    "continuity_states": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/continuity_state"}
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/binding"}
    },
    "prompt_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/prompt_unit"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_surface": {
            "properties": {"version": {"const": "2.5"}},
            "required": ["version"]
          }
        },
        "required": ["model_surface"]
      },
      "then": {"required": ["method_application"]}
    }
  ],
  "$defs": {
    "id_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "state_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "asset_foundation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "pass_id",
        "pass_artifact_sha256",
        "stress_test_id",
        "stress_report_sha256",
        "stress_verdict",
        "requested_shot_ids",
        "allowed_shot_ids",
        "blocked_shot_ids"
        ,"covered_asset_ids"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "pass_id": {"type": "string", "minLength": 1},
        "pass_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stress_test_id": {"type": "string", "minLength": 1},
        "stress_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stress_verdict": {"enum": ["certified", "conditional", "rejected", "unverified"]},
        "requested_shot_ids": {"$ref": "#/$defs/id_array"},
        "allowed_shot_ids": {"$ref": "#/$defs/id_array"},
        "blocked_shot_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "covered_asset_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "authoritative_script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_id", "source_relative_path", "sha256", "dialogue_lines"],
      "properties": {
        "script_id": {"type": "string", "minLength": 1},
        "source_relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "next_source_start": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_line_number", "source_line_sha256", "text"],
              "properties": {
                "source_line_number": {"type": "integer", "minimum": 1},
                "source_line_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "text": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "dialogue_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dialogue_line_id", "speaker_entity_id", "text", "source_line_number", "source_line_sha256", "shot_ids"],
            "properties": {
              "dialogue_line_id": {"type": "string", "minLength": 1},
              "speaker_entity_id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "source_line_number": {"type": "integer", "minimum": 1},
              "source_line_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "shot_ids": {"$ref": "#/$defs/id_array"}
            }
          }
        }
      }
    },
    "entity_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "owner", "shot_ids", "generation_unit_ids"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "shot_ids": {"$ref": "#/$defs/id_array"},
        "generation_unit_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "model_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_card_id",
        "model_key",
        "version",
        "provider_surface",
        "status",
        "verification_status"
      ],
      "properties": {
        "capability_card_id": {"type": "string", "minLength": 1},
        "model_key": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "provider_surface": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "verification_status": {"const": "verified"}
      }
    },
    "narrative_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "shot_ids", "story_function"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^N[0-9]{2,}$"},
        "shot_ids": {"$ref": "#/$defs/id_array"},
        "story_function": {"type": "string", "minLength": 1}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "node_id",
        "generation_unit_id",
        "time_start",
        "time_end",
        "scene_anchor",
        "primary_action",
        "entity_ids"
      ],
      "properties": {
        "shot_id": {"type": "string", "pattern": "^SH?[0-9]{2,}$"},
        "node_id": {"type": "string", "pattern": "^N[0-9]{2,}$"},
        "generation_unit_id": {"type": "string", "pattern": "^GU[0-9]{2,}$"},
        "time_start": {"type": "string", "pattern": "^[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?$"},
        "time_end": {"type": "string", "pattern": "^[0-9]{2}:[0-5][0-9](?:\\.[0-9]+)?$"},
        "scene_anchor": {"type": "string", "minLength": 1},
        "primary_action": {"type": "string", "minLength": 1},
        "entity_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "method_application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider_skill_id", "metadata_version", "observed_metadata_version", "authority", "non_adoption_reason", "project_default_segment_max_seconds", "current_segment_max_seconds", "current_limit_scope", "dialogue_edit_authority", "output_unit_policy", "binding_scope", "dynamic_state_policy", "prompt_surface_policy", "capacity_preflight"],
      "properties": {
        "status": {"enum": ["applied_unverified", "not_applied"]},
        "provider_skill_id": {"const": "mr-li-seedance-25"},
        "metadata_version": {"type": ["string", "null"]},
        "observed_metadata_version": {"type": ["string", "null"]},
        "authority": {"enum": ["isolated_method_only", "converter_fallback"]},
        "non_adoption_reason": {"type": ["string", "null"], "enum": ["provider_missing", "version_mismatch", "body_unavailable", "references_unavailable", "context_budget", null]},
        "project_default_segment_max_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "current_segment_max_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "current_limit_scope": {"enum": ["project_default", "current_segment_override"]},
        "dialogue_edit_authority": {"enum": ["none", "explicit_current_scope"]},
        "output_unit_policy": {"const": "one_natural_generation_unit_at_a_time"},
        "binding_scope": {"const": "current_segment_actual_assets_only"},
        "dynamic_state_policy": {"const": "shot_order_not_binding_freeze"},
        "prompt_surface_policy": {"const": "heading_free_no_packaging_names"},
        "capacity_preflight": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generation_unit_id", "scene_type", "dialogue_characters", "estimated_seconds", "draft_review_seconds", "status", "scene_completion_claim", "next_source_start"],
            "properties": {
              "generation_unit_id": {"type": "string", "pattern": "^GU[0-9]{2,}$"},
              "scene_type": {"enum": ["dialogue", "action", "mixed"]},
              "dialogue_characters": {"type": "integer", "minimum": 0},
              "estimated_seconds": {"type": "number", "exclusiveMinimum": 0},
              "draft_review_seconds": {"type": "number", "exclusiveMinimum": 0},
              "status": {"const": "pass"},
              "scene_completion_claim": {"enum": ["segment_only", "scene_complete"]},
              "next_source_start": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "generation_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_unit_id",
        "shot_ids",
        "duration_seconds",
        "continuity_in",
        "continuity_out"
      ],
      "properties": {
        "generation_unit_id": {"type": "string", "pattern": "^GU[0-9]{2,}$"},
        "shot_ids": {"$ref": "#/$defs/id_array"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "continuity_in": {"$ref": "#/$defs/state_map"},
        "continuity_out": {"$ref": "#/$defs/state_map"}
      }
    },
    "continuity_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "entity_id", "allowed_predecessors", "owner"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "allowed_predecessors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {"const": "image"},
              "status": {"const": "available"},
              "attached_to_run": {"const": true},
              "direct_input_policy": {"enum": ["allowed", "conditional"]}
            },
            "required": ["media_type", "status", "attached_to_run", "direct_input_policy"]
          },
          "then": {"required": ["asset_version", "relative_path", "sha256"]}
        },
        {
          "if": {
            "properties": {"source_kind": {"const": "character_detail_sheet"}},
            "required": ["source_kind"]
          },
          "then": {"required": ["reference_id"]}
        },
        {
          "if": {
            "properties": {"source_kind": {"const": "exact_graphic_reference"}},
            "required": ["source_kind"]
          },
          "then": {
            "properties": {
              "status": {"const": "planning_only"},
              "user_lock_status": {"const": "planning_only"},
              "direct_input_policy": {"const": "planning_only"},
              "attached_to_run": {"const": false},
              "literal_frame_boolean": {"const": false}
            }
          }
        }
      ],
      "required": [
        "binding_id",
        "asset_id",
        "media_type",
        "source_kind",
        "status",
        "rights_status",
        "user_lock_status",
        "direct_input_policy",
        "global_number",
        "converter_slot",
        "platform_slot",
        "role",
        "must_not_control",
        "literal_frame_boolean",
        "attached_to_run",
        "shot_ids",
        "unit_ids",
        "local_order_by_gu"
      ],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "reference_id": {"type": "string", "minLength": 1},
        "asset_version": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "media_type": {"enum": ["image", "audio", "video"]},
        "source_kind": {
          "enum": [
            "identity_reference",
            "face_identity_reference",
            "headless_wardrobe_reference",
            "character_master_sheet",
            "character_state_sheet",
            "character_headless_sheet",
            "character_detail_sheet",
            "exact_graphic_reference",
            "scene_anchor",
            "model_layout_reference",
            "human_planning_board",
            "narrative_frame",
            "clean_frame",
            "audio_asset",
            "video_asset"
          ]
        },
        "status": {
          "enum": ["available", "planned", "optional", "post_dub", "rejected", "planning_only"]
        },
        "rights_status": {"enum": ["verified", "conditional", "blocked"]},
        "user_lock_status": {
          "enum": ["user_locked", "internal_candidate", "external_imported", "planning_only"]
        },
        "approval_receipt_id": {"type": "string", "minLength": 1},
        "direct_input_policy": {
          "enum": ["allowed", "conditional", "forbidden", "planning_only"]
        },
        "global_number": {"type": "integer", "minimum": 1},
        "converter_slot": {
          "type": "string",
          "pattern": "^【(?:图片|音频|视频)[1-9][0-9]*】$"
        },
        "platform_slot": {
          "type": "string",
          "pattern": "^@(?:Image|Audio|Video) [1-9][0-9]*$"
        },
        "role": {"type": "string", "minLength": 1},
        "voice_owner_entity_id": {"type": "string", "minLength": 1},
        "must_not_control": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "literal_frame_boolean": {"type": "boolean"},
        "attached_to_run": {"type": "boolean"},
        "shot_ids": {"$ref": "#/$defs/id_array"},
        "unit_ids": {"$ref": "#/$defs/id_array"},
        "local_order_by_gu": {
          "type": "object",
          "propertyNames": {"pattern": "^GU[0-9]{2,}$"},
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 64}
        }
      }
    },
    "prompt_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_unit_id",
        "binding_ids",
        "artifact_id",
        "status",
        "prompt_text",
        "prompt_sha256"
      ],
      "properties": {
        "generation_unit_id": {"type": "string", "pattern": "^GU[0-9]{2,}$"},
        "binding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "artifact_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["prompt_only", "instructions_only"]},
        "prompt_text": {"type": "string", "minLength": 24},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
