{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dircreative.local/schemas/asset-foundation-pass.schema.json",
  "title": "DIRcreative staged asset foundation pass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "authority",
    "source_owner",
    "output_owner",
    "project_id",
    "pass_id",
    "status",
    "canonical_asset_ids",
    "planning_source_ids",
    "source_assets",
    "target_shot_ids",
    "stages",
    "stress_test_binding",
    "compile_gate"
  ],
  "properties": {
    "contract_id": {"const": "asset_foundation_pass_v1"},
    "authority": {"const": "staged_validation"},
    "source_owner": {"const": "dircreative"},
    "output_owner": {"const": "dircreative"},
    "project_id": {"$ref": "#/$defs/id"},
    "pass_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["in_progress", "blocked", "complete"]},
    "canonical_asset_ids": {"$ref": "#/$defs/id_list"},
    "planning_source_ids": {"$ref": "#/$defs/id_list"},
    "source_assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_asset"}},
    "target_shot_ids": {"$ref": "#/$defs/id_list"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/stage"}
    },
    "stress_test_binding": {"$ref": "#/$defs/stress_binding"},
    "compile_gate": {"$ref": "#/$defs/compile_gate"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "relative_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "source_kind", "role", "relative_path", "sha256"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"},
        "source_kind": {"enum": ["canonical_asset", "planning_only"]},
        "role": {"enum": ["canonical", "planning_only"]},
        "relative_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "sequence",
        "owner_skill_id",
        "collaborator_skill_ids",
        "validator_skill_id",
        "input_artifact",
        "previous_output_sha256",
        "output_artifact",
        "required_gaps",
        "covered_gaps",
        "missing_gaps",
        "status",
        "promotion_state"
      ],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 6},
        "owner_skill_id": {"$ref": "#/$defs/id"},
        "collaborator_skill_ids": {"$ref": "#/$defs/id_list"},
        "validator_skill_id": {"type": ["string", "null"]},
        "input_artifact": {"$ref": "#/$defs/artifact"},
        "previous_output_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "output_artifact": {"$ref": "#/$defs/artifact"},
        "required_gaps": {"$ref": "#/$defs/id_list"},
        "covered_gaps": {"$ref": "#/$defs/id_list"},
        "missing_gaps": {"$ref": "#/$defs/id_list"},
        "status": {"enum": ["not_run", "in_progress", "passed", "failed"]},
        "promotion_state": {"enum": ["planning_only", "candidate", "validated_candidate"]}
      }
    },
    "stress_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stress_test_id",
        "covered_asset_ids",
        "report_relative_path",
        "report_sha256",
        "verdict",
        "validation_status",
        "allowed_shot_scope",
        "blocked_shot_scope"
      ],
      "properties": {
        "stress_test_id": {"$ref": "#/$defs/id"},
        "covered_asset_ids": {"$ref": "#/$defs/id_list"},
        "report_relative_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "verdict": {"enum": ["certified", "conditional", "rejected", "unverified"]},
        "validation_status": {"enum": ["passed", "failed", "not_run"]},
        "allowed_shot_scope": {"$ref": "#/$defs/id_list"},
        "blocked_shot_scope": {"$ref": "#/$defs/id_list"}
      }
    },
    "compile_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_shot_ids", "status", "reason_codes"],
      "properties": {
        "requested_shot_ids": {"$ref": "#/$defs/id_list"},
        "status": {"enum": ["allowed", "blocked"]},
        "reason_codes": {"$ref": "#/$defs/id_list"}
      }
    }
  }
}
