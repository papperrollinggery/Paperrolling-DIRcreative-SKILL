{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dircreative.local/schemas/storyboard-frame-to-jingzao.schema.json",
  "title": "DIRcreative to Jingzao frame handoff and Delivery consumption receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "authority",
    "source_owner",
    "target_owner",
    "output_owner",
    "input_spec",
    "provider_skill",
    "reference_reads",
    "frames",
    "output_spec",
    "delivery_consumption",
    "fixture_only"
  ],
  "properties": {
    "contract_id": {"const": "storyboard_frame_to_jingzao_v1"},
    "authority": {"const": "compile_only"},
    "source_owner": {"const": "dircreative"},
    "target_owner": {"const": "jingzao-image-forge"},
    "output_owner": {"const": "dircreative"},
    "fixture_only": {"type": "boolean"},
    "input_spec": {"$ref": "#/$defs/artifact_binding"},
    "provider_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "sha256"],
      "properties": {
        "skill_id": {"const": "jingzao-image-forge"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reference_reads": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference_read"}
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    },
    "output_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "relative_path",
        "sha256",
        "prompt_manifest_id",
        "prompt_manifest_relative_path",
        "prompt_manifest_sha256"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "prompt_manifest_id": {"type": "string", "minLength": 1},
        "prompt_manifest_relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "prompt_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "style_capsule": {"$ref": "#/$defs/artifact_binding"},
        "prompt_authority_review_relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "prompt_authority_review_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_authority_review_signature_relative_path": {"$ref": "#/$defs/safe_relative_path"}
      }
    },
    "delivery_consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "adapter",
        "status",
        "consumed_spec_id",
        "consumed_spec_sha256",
        "generated"
      ],
      "properties": {
        "route_id": {"const": "generation_authorization"},
        "adapter": {"const": "imagegen"},
        "status": {"enum": ["planned", "observed_unverified", "failed"]},
        "consumed_spec_id": {"type": "string", "minLength": 1},
        "consumed_spec_sha256": {"$ref": "#/$defs/sha256"},
        "generated": {"const": false},
        "host_trace": {"$ref": "#/$defs/host_trace"},
        "frame_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/frame_output"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "observed_unverified"}}
          },
          "then": {"required": ["host_trace", "frame_outputs"]}
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "id_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "id_list": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attachment_binding": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256"], "properties": {"relative_path": {"$ref": "#/$defs/safe_relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "relative_path": {"$ref": "#/$defs/safe_relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "prefix_bytes", "prefix_sha256"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1},
        "prefix_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "prefix_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "frame_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "execution_receipt", "generated_artifact"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "execution_receipt": {"$ref": "#/$defs/artifact_file"},
        "generated_artifact": {"$ref": "#/$defs/artifact_file"}
      }
    },
    "reference_read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "bytes"],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^references/[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "dynamic_field": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "not_applicable"},
            "reason": {"type": "string", "minLength": 8}
          }
        }
      ]
    },
    "reference_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "role", "must_not_control"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "identity",
            "wardrobe",
            "vehicle",
            "scene",
            "prop",
            "camera_action",
            "layout",
            "style",
            "palette",
            "clean_frame_state"
          ]
        },
        "must_not_control": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "attachment": {"$ref": "#/$defs/attachment_binding"},
        "spatial_source": {"$ref": "#/$defs/attachment_binding"},
        "spatial_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shot_id", "phase"],
          "properties": {
            "shot_id": {"type": "string", "minLength": 1},
            "phase": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "truth_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "status", "scene_asset_id", "required_attachment_ids", "support", "parent_frame_ids", "constraint_input"],
      "properties": {
        "risk": {"enum": ["low", "medium", "high"]},
        "status": {"enum": ["ready", "blocked", "failed"]},
        "scene_asset_id": {"type": "string", "minLength": 1},
        "required_attachment_ids": {"$ref": "#/$defs/id_array"},
        "parent_frame_ids": {"$ref": "#/$defs/id_list"},
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "subject_asset_id", "anchor_asset_id", "relationship", "visibility"],
          "properties": {
            "status": {"enum": ["required", "not_required"]},
            "subject_asset_id": {"type": ["string", "null"], "minLength": 1},
            "anchor_asset_id": {"type": ["string", "null"], "minLength": 1},
            "relationship": {"type": "string", "minLength": 1},
            "visibility": {"enum": ["explicit_in_frame", "not_visible", "not_required"]}
          }
        },
        "constraint_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "asset_id"],
          "properties": {
            "mode": {"enum": ["none", "scene_reference", "spatial_mockup", "depth_layout", "multi_view"]},
            "asset_id": {"type": ["string", "null"], "minLength": 1}
          }
        }
      }
    },
    "panel_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_file",
        "coverage_sha256",
        "panel_id",
        "phase",
        "at_seconds",
        "state"
      ],
      "properties": {
        "coverage_file": {"$ref": "#/$defs/safe_relative_path"},
        "coverage_sha256": {"$ref": "#/$defs/sha256"},
        "panel_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "at_seconds": {"type": "number"},
        "state": {"type": "string", "minLength": 1}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "shot_id",
        "generation_unit_id",
        "shot_class",
        "shot_function",
        "narrative_purpose",
        "viewer_task",
        "viewer_position",
        "dominant_read",
        "secondary_read",
        "depth_roles",
        "camera_motivation",
        "quiet_region",
        "action_vector_counterforce",
        "crop_pressure",
        "parallax_occlusion",
        "exaggeration",
        "canonical_asset_ids",
        "reference_roles"
      ],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "shot_id": {"type": "string", "minLength": 1},
        "generation_unit_id": {"type": "string", "minLength": 1},
        "shot_class": {
          "enum": [
            "action",
            "transition",
            "dialogue",
            "observation",
            "static_product",
            "identity",
            "interview",
            "calm"
          ]
        },
        "shot_function": {"type": "string", "minLength": 1},
        "narrative_purpose": {"type": "string", "minLength": 1},
        "viewer_task": {"type": "string", "minLength": 1},
        "viewer_position": {"type": "string", "minLength": 1},
        "dominant_read": {"type": "string", "minLength": 1},
        "secondary_read": {"type": "string", "minLength": 1},
        "depth_roles": {"type": "string", "minLength": 1},
        "camera_motivation": {"type": "string", "minLength": 1},
        "quiet_region": {"type": "string", "minLength": 1},
        "action_vector_counterforce": {"$ref": "#/$defs/dynamic_field"},
        "crop_pressure": {"$ref": "#/$defs/dynamic_field"},
        "parallax_occlusion": {"$ref": "#/$defs/dynamic_field"},
        "exaggeration": {"$ref": "#/$defs/dynamic_field"},
        "canonical_asset_ids": {"$ref": "#/$defs/id_array"},
        "panel_context": {"$ref": "#/$defs/panel_context"},
        "truth_contract": {"$ref": "#/$defs/truth_contract"},
        "reference_roles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference_role"}
        }
      }
    }
  }
}
